<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="taran" name="Архитектура программы"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="game" value="<b>Точка входа: game.py</b><br>main(), игровой цикл, события, кадр, сущности сцены" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=22;fontColor=#e8eefc;fillColor=#18241e;strokeColor=#76e29e;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1440" height="64" as="geometry"/></mxCell><mxCell id="ui" value="Представление · taran/ui" style="swimlane;rounded=1;html=1;startSize=30;fontFamily=Segoe UI;fontSize=15;fontColor=#0a0c14;fillColor=#68a0ff;strokeColor=#68a0ff;swimlaneFillColor=#12151f;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="1440" height="180" as="geometry"/></mxCell><mxCell id="hud" value="<b>taran/ui/hud.py</b><br>HUD рейса, сердца,<br>полоса босса, «Депо»" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=20;fontColor=#e8eefc;fillColor=#1c2232;strokeColor=#68a0ff;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="320" height="100" as="geometry"/></mxCell><mxCell id="shop" value="<b>taran/ui/shop.py</b><br>«Мастерская»: вкладки,<br>карточки, цены" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=20;fontColor=#e8eefc;fillColor=#1c2232;strokeColor=#68a0ff;" vertex="1" parent="1"><mxGeometry x="420" y="250" width="320" height="100" as="geometry"/></mxCell><mxCell id="theme" value="<b>taran/ui/theme.py</b><br>палитра UI_*<br>без pygame" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=20;fontColor=#e8eefc;fillColor=#1c2232;strokeColor=#68a0ff;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="320" height="100" as="geometry"/></mxCell><mxCell id="progui" value="<b>prog_ui.py</b><br>реэкспорт hud<br>для старых импортов" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=20;fontColor=#e8eefc;fillColor=#1c2232;strokeColor=#6e7894;" vertex="1" parent="1"><mxGeometry x="1120" y="250" width="330" height="100" as="geometry"/></mxCell><mxCell id="logic" value="Логика и вычисления" style="swimlane;rounded=1;html=1;startSize=30;fontFamily=Segoe UI;fontSize=15;fontColor=#0a0c14;fillColor=#ffd070;strokeColor=#ffd070;swimlaneFillColor=#12151f;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="940" height="180" as="geometry"/></mxCell><mxCell id="prog" value="<b>progression.py</b><br>дерево, реликвии,<br>контракты, офлайн-доход" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=20;fontColor=#e8eefc;fillColor=#1e1e1e;strokeColor=#aa8cff;" vertex="1" parent="1"><mxGeometry x="70" y="465" width="280" height="100" as="geometry"/></mxCell><mxCell id="logicpy" value="<b>taran/logic.py</b><br>цены, инфляция,<br>пороги станций" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=20;fontColor=#e8eefc;fillColor=#1e1e1e;strokeColor=#ffd070;" vertex="1" parent="1"><mxGeometry x="370" y="465" width="280" height="100" as="geometry"/></mxCell><mxCell id="saves" value="<b>taran/saves.py</b><br>load_save / write_save<br>миграция и защита" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=20;fontColor=#e8eefc;fillColor=#1e1e1e;strokeColor=#ffd070;" vertex="1" parent="1"><mxGeometry x="670" y="465" width="280" height="100" as="geometry"/></mxCell><mxCell id="store" value="<b>Внешнее хранилище</b><br>save.json на десктопе<br>localStorage в браузере и APK<br>схема meta v4, миграция" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=21;fontColor=#e8eefc;fillColor=#262218;strokeColor=#ffd070;" vertex="1" parent="1"><mxGeometry x="1020" y="410" width="460" height="180" as="geometry"/></mxCell><mxCel